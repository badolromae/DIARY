<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wk_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_section_bg"
    android:layout_marginTop="6dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <View
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:background="@color/brand_accent" />

    <TextView
        android:id="@+id/wk_head_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1일 (월)"
        android:textColor="@color/widget_header_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wk_head_sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/widget_lunar_text"
        android:textSize="11sp" />
</LinearLayout>
